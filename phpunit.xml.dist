<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuration des tests : https://docs.phpunit.de -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnEmptyTestSuite="true">
    <testsuites>
        <!-- La conversion se teste sans base ni serveur web -->
        <testsuite name="conversion">
            <directory>tests/Conversion</directory>
        </testsuite>
        <!-- Ces tests ont besoin de la base PostGIS démarrée -->
        <testsuite name="base">
            <directory>tests/Base</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
